# 이 파일을 .env 로 복사한 뒤 값을 수정해 주세요.

# 서버 포트
PORT=3000

# 가입 코드. 값을 넣으면 두 번째 가입자부터 이 코드를 입력해야 가입할 수 있습니다.
# 사내에서 사용할 때는 반드시 설정하는 것을 권장합니다.
SIGNUP_CODE=

# 첨부 파일 최대 크기 (MB)
MAX_FILE_MB=20

# 로그인 유지 기간 (일)
SESSION_DAYS=14

# 데이터 저장 폴더 (데이터베이스와 첨부 파일). 비워 두면 프로그램 폴더 안의 data 폴더를 사용합니다.
# DATA_DIR=/var/lib/erp-messenger

# HTTPS로 서비스할 때 true 로 설정 (로그인 쿠키를 HTTPS에서만 전송)
COOKIE_SECURE=false

# Nginx 같은 역방향 프록시 뒤에서 실행할 때 true 로 설정
TRUST_PROXY=false
